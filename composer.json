{
    "name": "granitehldg/filament-iban-input",
    "description": "A Filament IBAN input with validation and formatting",
    "keywords": ["filament", "iban", "bank", "forms", "laravel"],
    "homepage": "https://github.com/granitehldg/filament-iban-input",
    "support": {
        "issues": "https://github.com/granitehldg/filament-iban-input/issues",
        "source": "https://github.com/granitehldg/filament-iban-input"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Granite Holding"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "filament/forms": "^3.0 || ^4.0",
        "filament/support": "^3.0 || ^4.0",
        "spatie/laravel-package-tools": "^1.14"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Granite\\FilamentIban\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Granite\\FilamentIban\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Granite\\FilamentIban\\FilamentIbanServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
